<resources>

    <style name="Theme.UniGo" parent="Theme.MaterialComponents.Light.NoActionBar">

        <!-- Primary -->
        <item name="colorPrimary">@color/mint_primary</item>
        <item name="colorPrimaryVariant">@color/mint_dark</item>
        <item name="colorOnPrimary">@color/mint_light</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/mint_light</item>
        <item name="colorSurface">@color/mint_soft</item>

        <item name="appBackground">@color/mint_light</item>
        <item name="appSurface">@color/mint_soft</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="fontFamily">@font/lexend</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/mint_dark</item>
        <item name="android:windowLightStatusBar">true</item>

    </style>

    <style name="SettingsBtn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:layout_marginHorizontal">6dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/custom_btn</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:fontFamily">@font/lexend</item>
    </style>
</resources>
