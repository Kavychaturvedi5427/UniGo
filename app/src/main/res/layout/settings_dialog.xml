<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/back"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/left"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/mainhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="26sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/lexend"/>
            </LinearLayout>

            <TextView
                android:id="@+id/subhead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/headerRow"
                android:layout_marginTop="8dp"
                android:text="Manage account and preferences"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/lexend"/>

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie"
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:layout_alignParentEnd="true"
                android:translationY="-8dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/settings"/>

        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginTop="7dp"
            android:background="@color/view"/>

        <!-- NOTIFICATION SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notification Settings"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/googlesans"
            android:layout_marginTop="14dp"
            android:layout_marginStart="6dp"/>

        <!-- Notification Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="General Notification"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/lexend"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGeneralNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Assignment Notification"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/lexend"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAssignNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notes Notification"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/lexend"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchNoteNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Attendance Notification"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/lexend"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAttendNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginTop="20dp"
            android:background="@color/view"/>

        <!-- ACCOUNT SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account Settings"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/googlesans"
            android:layout_marginTop="14dp"
            android:layout_marginStart="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/editProfileBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="Edit Profile"
                android:textAllCaps="false"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/custom_btn"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/resetPasswordBtn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="Reset Password"
                android:textAllCaps="false"
                android:foreground="?attr/selectableItemBackground"
                android:background="@drawable/custom_btn"/>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/deleteAccountBtn"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:text="Delete Account"
            android:textAllCaps="false"
            android:textColor="@color/red"
            android:foreground="?attr/selectableItemBackground"
            android:background="@drawable/custom_btn"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginTop="20dp"
            android:background="@color/view"/>

        <!-- APP SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/googlesans"
            android:layout_marginTop="14dp"
            android:layout_marginStart="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/aboutAppBtn"
                style="@style/SettingsBtn"
                android:text="About UniGo" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/contactDevBtn"
                style="@style/SettingsBtn"
                android:text="Contact Developer" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/privacyPolicyBtn"
                style="@style/SettingsBtn"
                android:text="Privacy Policy" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/termsBtn"
                style="@style/SettingsBtn"
                android:text="Terms of Use" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/signOutBtn"
                style="@style/SettingsBtn"
                android:text="Sign Out"
                android:textColor="@color/red" />

        </LinearLayout>
        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UniGo • 2026"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:alpha="0.7"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_gravity="center"
            android:layout_marginTop="1dp"
            android:alpha="0.7"/>


        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>