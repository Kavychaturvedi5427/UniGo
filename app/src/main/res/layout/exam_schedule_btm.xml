<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="30dp">

        <!-- Drag Handle -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="25dp"
            android:layout_height="3dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:background="@color/black"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent" />

        <!-- Heading -->
        <TextView
            android:id="@+id/examHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/lexend"
            android:text="Exam Schedule"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <!-- Illustration -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/examIllustration"
            android:layout_width="130dp"
            android:layout_height="110dp"
            android:layout_alignParentEnd="true"
            android:translationX="15dp"
            android:translationY="2dp"
            android:elevation="10dp"
            android:contentDescription="@string/Illustration"
            app:lottie_rawRes="@raw/exams"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>

        <!-- Subheading -->
        <TextView
            android:id="@+id/examSubheading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/examHeading"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/lexend"
            android:text="Upload timetable to detect exams"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Divider -->
        <View
            android:id="@+id/div1"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_below="@id/examSubheading"
            android:layout_marginStart="25dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="25dp"
            android:background="@color/view" />

        <!-- No Schedule Placeholder --><!-- Schedule Section -->
        <LinearLayout
            android:id="@+id/scheduleSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/div1"
            android:layout_marginTop="20dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/noScheduleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No schedule present"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:gravity="center"/>

            <LinearLayout
                android:id="@+id/scheduleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Gallery + Camera Row -->
        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/scheduleSection"
            android:layout_marginTop="25dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/galleryBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/custom_btn"
                android:text="Choose from Gallery"
                android:textAllCaps="false"
                android:padding="10dp"
                android:textStyle="bold"/>

        </LinearLayout>

    </RelativeLayout>

</ScrollView>