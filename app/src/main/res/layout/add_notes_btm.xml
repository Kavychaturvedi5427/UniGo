<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="30dp">

        <!-- Drag Handle -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="25dp"
            android:layout_height="3dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:background="@color/black"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent" />

        <!-- Heading -->
        <TextView
            android:id="@+id/notesHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/lexend"
            android:text="Add Notes"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <!-- Illustration -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/notesIllustration"
            android:layout_width="150dp"
            android:layout_height="130dp"
            android:layout_alignParentEnd="true"
            android:contentDescription="@string/Illustration"
            android:elevation="10dp"
            android:translationX="40dp"
            android:translationY="2dp"
            app:lottie_rawRes="@raw/notes"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>

        <!-- Subheading -->
        <TextView
            android:id="@+id/notesSubheading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/notesHeading"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/lexend"
            android:text="Upload or manage your notes easily"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Divider -->
        <View
            android:id="@+id/div1"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_below="@id/notesSubheading"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="25dp"
            android:background="@color/view" />

        <!-- Gallery + Camera Row -->
        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/div1"
            android:layout_marginTop="25dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/galleryBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/custom_btn"
                android:text="Choose from Gallery"
                android:textAllCaps="false"
                android:padding="10dp"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cameraBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/custom_btn"
                android:text="Click from Camera"
                android:textAllCaps="false"
                android:padding="10dp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- View Saved Notes Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/viewNotesBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/buttonRow"
            android:layout_marginTop="20dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:background="@drawable/custom_btn"
            android:text="View Saved Notes"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:padding="10dp"/>

    </RelativeLayout>

</ScrollView>