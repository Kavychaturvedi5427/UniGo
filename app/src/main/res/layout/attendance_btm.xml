<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="30dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="25dp"
            android:layout_height="3dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:background="@color/black"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent" />

        <TextView
            android:id="@+id/loginTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/lexend"
            android:text="Add Attendance"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <ImageView
            android:id="@+id/RocketIllustration"
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:layout_alignParentEnd="true"
            android:layout_gravity="end"
            android:contentDescription="@string/Illustration"
            android:elevation="10dp"
            android:rotation="-10"
            android:src="@drawable/attendance"
            android:translationX="40dp"
            android:translationY="2dp" />

        <TextView
            android:id="@+id/welcomeLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/loginTxt"
            android:layout_marginVertical="10dp"
            android:layout_marginStart="25dp"
            android:fontFamily="@font/lexend"
            android:text="Enter lecture details for today"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <View
            android:id="@+id/div1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/welcomeLogin"
            android:layout_marginStart="25dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="25dp"
            android:background="@color/gray" />

        <TextView
            android:id="@+id/Enterattended"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/div1"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/lexend"
            android:text="Attended Lectures Today"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/attendedlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/Enterattended"
            android:layout_marginStart="25sp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="25sp"
            android:hint="Enter number of lectures attended">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/attendedtxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:fontFamily="@font/lexend"
                android:inputType="number"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/totallectoday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/attendedlay"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/lexend"
            android:text="Total Lectures Today"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/totalleclay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/totallectoday"
            android:layout_marginStart="25sp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="25sp"
            android:hint="Enter total lectures conducted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/totallectxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:fontFamily="@font/lexend"
                android:inputType="number"
                android:textSize="12sp"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/validation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/totalleclay"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/lexend"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:text="⚠ Attended lectures cannot exceed total lectures"
            android:visibility="gone"
            />

        <View
            android:id="@+id/div2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/validation"
            android:layout_marginStart="25dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="25dp"
            android:background="@color/gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@id/div2"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:padding="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/savebtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_btn"
                android:elevation="15dp"
                android:text="@string/save"
                android:layout_margin="5dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cancelbtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_btn"
                android:elevation="15dp"
                android:text="@string/cancel"
                android:layout_margin="5dp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/Progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:layout_marginTop="16dp"
            android:indeterminateDrawable="@drawable/progressbar"
            android:visibility="gone" />

    </RelativeLayout>

</ScrollView>
