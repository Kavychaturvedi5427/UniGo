<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/mainCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:cardUseCompatPadding="true"
            app:cardPreventCornerOverlap="true"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <!-- App Name -->

                <TextView
                    android:id="@+id/apptxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="@string/app_name"
                    android:textSize="20sp"
                    android:fontFamily="@font/googlesans"
                    android:textColor="@color/text_primary"/>

                <!-- Logo -->

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_below="@id/apptxt"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/logo"/>

                <!-- Divider -->

                <View
                    android:id="@+id/div1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@id/logo"
                    android:layout_marginVertical="16dp"
                    android:background="#33000000"/>

                <!-- About Title -->

                <TextView
                    android:id="@+id/aboutTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/div1"
                    android:layout_centerHorizontal="true"
                    android:text="About UniGo"
                    android:textSize="20sp"
                    android:fontFamily="@font/googlesans"
                    android:textColor="@color/text_primary"/>

                <!-- Description -->

                <TextView
                    android:id="@+id/about_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/aboutTxt"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="16dp"
                    android:text="@string/app_desc"
                    android:textSize="16sp"
                    android:fontFamily="@font/lexend"
                    android:gravity="center"
                    android:textColor="@color/text_primary"/>

                <!-- Divider -->

                <View
                    android:id="@+id/div3"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@id/about_desc"
                    android:layout_marginVertical="16dp"
                    android:background="#33000000"/>

                <!-- Developer Section -->

                <LinearLayout
                    android:id="@+id/devLL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/div3"
                    android:layout_centerHorizontal="true"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Developer : "
                        android:textSize="16sp"
                        android:fontFamily="@font/googlesans"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kavy Chaturvedi"
                        android:textSize="16sp"
                        android:fontFamily="@font/lexend"
                        android:textColor="@color/text_primary"/>

                </LinearLayout>

                <!-- Social Links -->

                <LinearLayout
                    android:id="@+id/contact_ll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/devLL"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Instagram -->

                    <LinearLayout
                        android:id="@+id/install"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/instagram"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instagram"
                            android:textSize="12sp"
                            android:fontFamily="@font/googlesans"
                            android:textColor="@color/text_primary"/>

                    </LinearLayout>

                    <!-- LinkedIn -->

                    <LinearLayout
                        android:id="@+id/linkedll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/linkedin"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LinkedIn"
                            android:textSize="12sp"
                            android:fontFamily="@font/googlesans"
                            android:textColor="@color/text_primary"/>

                    </LinearLayout>

                    <!-- GitHub -->

                    <LinearLayout
                        android:id="@+id/gitll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginHorizontal="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/github"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GitHub"
                            android:textSize="12sp"
                            android:fontFamily="@font/googlesans"
                            android:textColor="@color/text_primary"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Version -->

                <LinearLayout
                    android:id="@+id/verll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/contact_ll"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App Version : "
                        android:textSize="15sp"
                        android:fontFamily="@font/googlesans"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v1.0.0"
                        android:textSize="15sp"
                        android:fontFamily="@font/lexend"
                        android:textColor="@color/text_primary"/>

                </LinearLayout>

                <!-- Terms -->

                <TextView
                    android:id="@+id/TermsOfUse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/verll"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="12dp"
                    android:text="Terms of Use"
                    android:textSize="14sp"
                    android:fontFamily="@font/googlesans"
                    android:textColor="@color/text_primary"/>

                <!-- Divider -->

                <View
                    android:id="@+id/div4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@id/TermsOfUse"
                    android:layout_marginVertical="16dp"
                    android:background="#33000000"/>

                <!-- Footer -->

                <TextView
                    android:id="@+id/copyright"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/div4"
                    android:layout_centerHorizontal="true"
                    android:text="@string/copyright"
                    android:textSize="14sp"
                    android:fontFamily="@font/googlesans"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/copyright"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="4dp"
                    android:text="@string/about_last_cmt"
                    android:textSize="14sp"
                    android:fontFamily="@font/googlesans"
                    android:textColor="@color/text_primary"/>

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>